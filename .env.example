# Stripe API Keys (from Stripe Dashboard > Developers > API keys)
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Stripe Webhook Secret (from Stripe CLI or Dashboard > Developers > Webhooks)
STRIPE_WEBHOOK_SECRET=whsec_...

# Site URL for checkout callbacks (http://localhost:3000 for local, https://fozprints.com.au for production)
NEXT_PUBLIC_SITE_URL=http://localhost:3000


# Australia Post API (from Australia Post Developer Centre)
AUSPOST_API_KEY=your_auspost_api_key
AUSPOST_FROM_POSTCODE=3000

# Contact form email via Resend (https://resend.com)
RESEND_API_KEY=re_...
# Where enquiries are delivered (defaults to info@fozprints.com.au)
CONTACT_TO_EMAIL=info@fozprints.com.au
# Must be an address on a domain verified in Resend (this is also the default)
CONTACT_FROM_EMAIL=info@fozprints.com.au

# PayPal (from developer.paypal.com > Apps & Credentials)
PAYPAL_ENVIRONMENT=sandbox
NEXT_PUBLIC_PAYPAL_CLIENT_ID=...
PAYPAL_CLIENT_SECRET=...
# Webhook ID for https://<your-site>/api/webhooks/paypal, subscribed to PAYMENT.CAPTURE.COMPLETED
PAYPAL_WEBHOOK_ID=...
